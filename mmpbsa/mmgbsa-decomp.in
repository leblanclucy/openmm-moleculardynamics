#change to match your number of frames in your trajectory and how many of those frames you want to analyze
&general
   startframe=2500, endframe=5000, interval=20,
   verbose=1, keep_files=0,
/
#for MM/GBSA. igb=5 matches mbondi2 atomic radius. saltcon=0.150 should match the molarity of your NaCl in molar.
&gb
   igb=5, saltcon=0.150,
/
#does decomposition on ALL residues with a high level of verbosity
#idecomp=2 combines 1-4 van der waals with total van der waals and 1-4 electrostatic added to total electrostatic
#as opposed to adding the 1-4 terms to the internal potential terms
#it seems to be the default and more common from what i've seen
&decomp
   idecomp=2,
   dec_verbose=1,
/
